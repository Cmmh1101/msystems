# Public site URL — used in metadata/canonical links. Stays the existing domain.
NEXT_PUBLIC_SITE_URL=https://inmotionwebsolutions.com

# Supabase — server-only, never exposed to the client
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — transactional email
RESEND_API_KEY=

# Where new-lead notifications are sent
NOTIFY_EMAIL=hello@inmotionwebsolutions.com

# Must match your verified Resend sending domain
FROM_EMAIL=hello@inmotionwebsolutions.com
