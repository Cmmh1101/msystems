# Public site URL — used in metadata/canonical links. Stays the existing domain.
NEXT_PUBLIC_SITE_URL=https://inmotionwebsolutions.com

# Supabase — server-only, never exposed to the client
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase anon/publishable key — used for the admin login session (respects RLS,
# safe to expose to the browser). Different from the service_role key above.
SUPABASE_ANON_KEY=

# Resend — transactional email
RESEND_API_KEY=

# Where new-lead notifications are sent
NOTIFY_EMAIL=hello@inmotionwebsolutions.com

# Must match your verified Resend sending domain
FROM_EMAIL=hello@inmotionwebsolutions.com

# The only email allowed to log into /admin. Create this exact user manually in
# Supabase Dashboard → Authentication → Users → Add User (no public signup exists).
ADMIN_EMAIL=

# GA4 Measurement ID (from Analytics → Admin → Data Streams → your web stream).
# Tracking only fires when NODE_ENV=production, so local dev never pollutes real data.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
